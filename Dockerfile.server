# ============================================================================
# Child Server Container Dockerfile
# ============================================================================
# Base image for individual Minecraft server containers.
# Each server gets its own isolated container with:
#   - Data volume (Docker named volume, subpath-mounted) at /data
#   - Root-started entrypoint that chowns /data and drops privileges to
#     the unprivileged minecraft user (UID 1000) via gosu before exec'ing
#     Java. This avoids the AccessDenied errors that happened when the
#     server ran as UID 1000 against host bind mounts that don't honour
#     chown on Docker Desktop for macOS/Windows.
#   - No published ports (only reachable via mc-net -> Infrared)
#   - Java 17, 21 and 25 runtimes side by side (/opt/java/jdk17, jdk21,
#     jdk25). The management container passes JAVA_VERSION per server
#     (Spigot 1.21.x refuses Java > 23, 1.17-1.20.4 want 17, new vanilla
#     releases run on 25); the entrypoint puts the chosen one on PATH.
#   - go-mmproxy (Cloudflare's mmproxy in Go): Infrared sends the player's
#     real address in a PROXY protocol header; go-mmproxy strips it and
#     re-originates the connection to Java over loopback *from the player's
#     IP*, so every server type (vanilla, Spigot, Forge, ...) logs real
#     player IPs without plugin/mod support. Needs CAP_NET_ADMIN at runtime;
#     the entrypoint degrades to a plain connection when it is missing.
# ============================================================================

# ---- Build stage: go-mmproxy -------------------------------------------------
FROM golang:1.23-alpine AS mmproxy-build
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
RUN go install github.com/path-network/go-mmproxy@latest \
    && /go/bin/go-mmproxy -h >/dev/null 2>&1 || true

# ---- Runtime image ------------------------------------------------------------
FROM eclipse-temurin:25-jre

# gosu for privilege-dropping in the entrypoint; iproute2 for the loopback
# routing rules go-mmproxy relies on.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu iproute2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mmproxy-build /go/bin/go-mmproxy /usr/local/bin/go-mmproxy

# ---- Additional Java runtimes ----
# Temurin images share the same Ubuntu base and ship Java at /opt/java/openjdk,
# so the runtimes can be copied straight in. The image default (25) stays at
# /opt/java/openjdk; the entrypoint switches JAVA_HOME/PATH via JAVA_VERSION.
COPY --from=eclipse-temurin:17-jre /opt/java/openjdk /opt/java/jdk17
COPY --from=eclipse-temurin:21-jre /opt/java/openjdk /opt/java/jdk21
RUN ln -s /opt/java/openjdk /opt/java/jdk25 \
    && /opt/java/jdk17/bin/java -version 2>&1 | head -1 \
    && /opt/java/jdk21/bin/java -version 2>&1 | head -1 \
    && /opt/java/jdk25/bin/java -version 2>&1 | head -1

# Create the non-root minecraft user/group at UID/GID 1000. The
# entrypoint execs as this UID via gosu.
RUN touch /etc/passwd /etc/group && \
    if getent passwd 1000; then userdel -r $(getent passwd 1000 | cut -d: -f1); fi && \
    if getent group 1000; then groupdel $(getent group 1000 | cut -d: -f1); fi && \
    groupadd -g 1000 minecraft && \
    useradd -m -u 1000 -g 1000 minecraft

# Advertise the real-IP helper so the management container only enables
# PROXY protocol routing for containers started from an image that has it.
LABEL mc-server-base.real-ip="true" \
      mc-server-base.java-versions="17,21,25"

# Working directory is /data; volume is mounted on top of this path at
# container start, so anything placed here at build time is shadowed.
WORKDIR /data

# Entrypoint: chown /data, start go-mmproxy (if permitted), then gosu to
# UID 1000 and exec the command.
COPY docker/server-entrypoint.sh /usr/local/bin/server-entrypoint.sh
RUN chmod +x /usr/local/bin/server-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/server-entrypoint.sh"]
CMD ["java", "-Xmx1024M", "-Xms1024M", "-jar", "server.jar", "nogui"]
